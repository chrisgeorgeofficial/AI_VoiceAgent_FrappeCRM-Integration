# Copy to .env and adjust. Real environment variables override this file.

# --- Telephony ---
# false: answer the call with <Say>.  true: hand the audio to /voice/media.
USE_MEDIA_STREAM = true

# Optional. Pin the wss:// host instead of reading it from the Host header,
# e.g. PUBLIC_HOST = abc123.ngrok-free.dev
# PUBLIC_HOST =

# --- Debug logging ---
# Log a heartbeat every N media frames (they arrive ~50/sec).
# LOG_MEDIA_EVERY = 100
# Set false to stop dumping request headers and form data on every webhook.
# LOG_REQUEST_DETAIL = true

# --- Sarvam ---
# Required. Your api-subscription-key from the Sarvam dashboard.
SARVAM_API_KEY =

# Language for the whole loop: transcription, the reply, and the voice.
# SARVAM_LANGUAGE = en-IN

# STT. saaras:v3 is the recommended streaming model; mode can be transcribe,
# translate, verbatim, translit or codemix.
# SARVAM_STT_MODEL = saaras:v3
# SARVAM_STT_MODE = transcribe

# Chat model behind the reply. Swap this one value (and app/agent/llm.py) if
# you move to another provider.
# SARVAM_CHAT_MODEL = sarvam-105b-conversations

# TTS voice.
# SARVAM_TTS_MODEL = bulbul:v3
# SARVAM_TTS_SPEAKER = shreya

# --- Agent loop ---
# How much audio to accumulate before sending a chunk to STT.
# STT_CHUNK_MS = 1000
# Set false to transcribe and print only - no LLM, no speech back.
# AGENT_REPLY_ENABLED = true
# Ignore inbound audio while the agent is talking, so it does not hear itself.
# HALF_DUPLEX = true
# Spoken as soon as the call connects. Set empty to answer in silence.
# GREETING_TEXT = Hello! Thanks for calling. What can I help you with today?
# How many past messages to replay to the model each turn.
# HISTORY_TURNS = 10

# --- Speech pacing ---
# true: start playing the reply as it is rendered (~0.7s to first audio).
# false: wait for the whole clip (~2.0s). Flip to false if audio ever stutters.
# TTS_STREAMING = true

# Let the caller talk over the agent and have it stop mid-sentence.
# BARGE_IN = true
# How loud a frame must be to count as speech, and how many in a row.
# 10 frames = 200ms. Raise BARGE_IN_RMS if a noisy line keeps cutting the agent
# off; lower it if it ignores you when you try to interrupt.
# BARGE_IN_RMS = 800
# BARGE_IN_FRAMES = 10

# --- Frappe CRM ---
# The Frappe *desk* URL (the one serving /api/resource), no trailing slash.
FRAPPE_URL = http://127.0.0.1:8000
# Generate under the Frappe user's API Access section. The secret shows once.
FRAPPE_API_KEY =
FRAPPE_API_SECRET =
# The custom DocType call results are written to.
# FRAPPE_DOCTYPE = AI Voice Agent
# Set false to run calls normally but write nothing to Frappe.
# CRM_ENABLED = true
# FRAPPE_TIMEOUT = 20
# Finished calls held in memory awaiting their status callback.
# TRANSCRIPT_CACHE_SIZE = 200

# --- CRM lead linking ---
# Telecallers new callers are shared between, in order. A caller whose lead
# already has an owner stays with that owner; this pool is only for new numbers.
CRM_TELECALLERS = telecaller1@test.com,telecaller2@test.com
# Open a lead when the caller's number matches none.
# CRM_CREATE_LEADS = true
# CRM_NEW_LEAD_STATUS = New
# Must be an existing CRM Lead Source, or left empty.
# CRM_NEW_LEAD_SOURCE =

# --- Call recording ---
# Record the call locally and attach it. Twilio's own recordings sit behind
# Twilio auth, so their URL would 401 for whoever clicks it in the CRM.
# RECORDING_ENABLED = true
# MAX_RECORDING_SECONDS = 600
# Who takes unowned callers, read live from Frappe: every enabled user holding
# this role. Add a telecaller in the CRM and they join the rotation - no edit
# here, no restart. Note "Sales User" includes managers; create a dedicated
# "Telecaller" role in Frappe if you want a narrower pool.
# CRM_TELECALLER_ROLE = Sales User
# Keep the caller and agent on separate stereo channels instead of mixing them.
# Useful for analysis; on one earbud you would hear only one of them.
# RECORDING_STEREO = false
